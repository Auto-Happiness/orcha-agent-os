!.yarn/plugins
!.yarn/releases
!.yarn/versions

# convex
convex/_generated/

/fortune-sheet
/Zenta


# testing
/coverage
/semantic-engine

# next.js
/.next/
/out/
/public/exports/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

